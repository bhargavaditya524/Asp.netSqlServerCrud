@model IEnumerable<DbDemoPractice.Models.Student>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>
<form asp-action="Index" method="get" class="row g-3 mb-3">
    <div class="col-auto">
        <label for="classFilter" class="form-label">Class</label>
        <select id="classFilter" name="classFilter" class="form-select" asp-items="ViewBag.Classes">
            <option value="">All classes</option>
        </select>
    </div>
    <div class="col-auto">
        <label for="genderFilter" class="form-label">Gender</label>
        <select id="genderFilter" name="genderFilter" class="form-select" asp-items="ViewBag.Genders">
            <option value="">All genders</option>
        </select>
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Roll)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StuName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StuGender)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Class)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StuDob)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StuPhone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Roll)
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.StuName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StuGender)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Class)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StuDob)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StuPhone)
            </td>
            <td>
                <a class="btn btn-dark" asp-action="Edit" asp-route-id="@item.Roll">Edit</a> |
                <a class="btn btn-secondary" asp-action="Details" asp-route-id="@item.Roll">Details</a> |
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Roll">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
